{
  "$comment": "Pinned from the NEAR Intents Agent API (Agent Connect) openapi.json. Only the Policy schema an owner signs.",
  "source": "https://api.demo.agentsonintents.com/openapi.json",
  "source_version": "1.0.0",
  "source_sha256": "1a6fe2ba31c9bda2bb68486983a3e879d301a236c671921e23caab3080b7a21a",
  "fetched": "2026-10-28",
  "schemas": {
    "Policy": {
      "type": "object",
      "properties": {
        "frozen": {
          "type": "boolean"
        },
        "actions": {
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "swap",
              "transfer",
              "withdraw"
            ]
          }
        },
        "confidential": {
          "type": "boolean"
        },
        "owner_approval": {
          "type": "boolean"
        },
        "assets": {
          "anyOf": [
            {
              "type": "string",
              "const": "any"
            },
            {
              "maxItems": 128,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          ]
        },
        "limits": {
          "type": "object",
          "properties": {
            "per_transaction": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[0-9]{1,78}$"
              }
            },
            "hourly": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[0-9]{1,78}$"
              }
            },
            "daily": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[0-9]{1,78}$"
              }
            },
            "monthly": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[0-9]{1,78}$"
              }
            }
          },
          "additionalProperties": false
        },
        "max_actions_per_hour": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "destinations": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "any",
                "only",
                "except"
              ]
            },
            "list": {
              "maxItems": 256,
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "action": {
                        "type": "string",
                        "const": "withdraw"
                      },
                      "chain": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                      },
                      "address": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "memo": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 256
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "action",
                      "chain",
                      "address",
                      "memo"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "action": {
                        "type": "string",
                        "const": "transfer"
                      },
                      "address": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 64
                      },
                      "confidential": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "action",
                      "address",
                      "confidential"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": [
            "mode",
            "list"
          ],
          "additionalProperties": false
        },
        "budget": {
          "type": "object",
          "properties": {
            "daily_usd": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,8})(\\.[0-9]{1,2})?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "weekly_usd": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,8})(\\.[0-9]{1,2})?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "monthly_usd": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,8})(\\.[0-9]{1,2})?$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "daily_usd",
            "weekly_usd",
            "monthly_usd"
          ],
          "additionalProperties": false
        },
        "timelock_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2592000000
        },
        "schedule": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "only",
                "except"
              ]
            },
            "time_zone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "windows": {
              "minItems": 1,
              "maxItems": 28,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "days": {
                    "minItems": 1,
                    "maxItems": 7,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "mon",
                        "tue",
                        "wed",
                        "thu",
                        "fri",
                        "sat",
                        "sun"
                      ]
                    }
                  },
                  "start": {
                    "type": "string",
                    "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  "end": {
                    "type": "string",
                    "pattern": "^(?:(?:[01]\\d|2[0-3]):[0-5]\\d|24:00)$"
                  }
                },
                "required": [
                  "days",
                  "start",
                  "end"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "mode",
            "time_zone",
            "windows"
          ],
          "additionalProperties": false
        },
        "native": {
          "type": "object",
          "properties": {
            "near": {
              "type": "object",
              "properties": {
                "sign_message": {
                  "maxItems": 256,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[\\x21-\\x7e]+$"
                  }
                },
                "transfer": {
                  "type": "boolean"
                },
                "call": {
                  "maxItems": 256,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 64,
                    "pattern": "^(?:[a-z\\d]+[-_])*[a-z\\d]+(?:\\.(?:[a-z\\d]+[-_])*[a-z\\d]+)*$"
                  }
                }
              },
              "required": [
                "sign_message",
                "transfer",
                "call"
              ],
              "additionalProperties": false
            },
            "evm": {
              "type": "object",
              "properties": {
                "sign_typed_data": {
                  "maxItems": 64,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "version": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      },
                      "chain_id": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "verifying_contract": {
                        "type": "string",
                        "pattern": "^0x[0-9a-f]{40}$"
                      },
                      "salt": {
                        "type": "string",
                        "pattern": "^0x[0-9a-f]{64}$"
                      },
                      "primary_types": {
                        "minItems": 1,
                        "maxItems": 32,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "sign_message": {
                  "type": "boolean"
                },
                "sign_transaction": {
                  "type": "boolean"
                }
              },
              "required": [
                "sign_typed_data",
                "sign_message",
                "sign_transaction"
              ],
              "additionalProperties": false
            },
            "solana": {
              "type": "object",
              "properties": {
                "sign_message": {
                  "type": "boolean"
                },
                "sign_transaction": {
                  "type": "boolean"
                }
              },
              "required": [
                "sign_message",
                "sign_transaction"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "near",
            "evm",
            "solana"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "frozen",
        "actions",
        "confidential",
        "owner_approval",
        "assets",
        "limits",
        "max_actions_per_hour",
        "destinations",
        "budget",
        "timelock_ms"
      ],
      "additionalProperties": false
    }
  }
}
