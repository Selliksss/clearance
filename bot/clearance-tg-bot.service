[Unit]
Description=Clearance Telegram bot (people send an agent prompt, it runs the crash test and replies with the report)
After=network-online.target
Wants=network-online.target

[Service]
User=clearance
Group=clearance
WorkingDirectory=/opt/clearance/runner
Environment=HOME=/var/lib/clearance
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# TELEGRAM_BOT_TOKEN=... only; root-owned, mode 600, kept out of ~/.config/dopusk/.env so the crash test cannot read it
EnvironmentFile=/etc/clearance/tg-bot.env
ExecStart=/usr/local/bin/node /opt/clearance/runner/node_modules/tsx/dist/cli.mjs ../bot/telegram.ts
Restart=always
RestartSec=30
SuccessExitStatus=130
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/clearance
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=2G

[Install]
WantedBy=multi-user.target
